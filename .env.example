# Copy this to .env. Default is SQLite, which is what runs inside this
# GitHub Codespace day to day (dev/build environment). When you're ready to
# test or launch against the real production database, switch DB_PROVIDER
# to "postgresql" and DATABASE_URL to your Neon connection string — nothing
# else changes. See scripts/set-db-provider.mjs and package.json's
# db:local:* / db:production:* scripts. Never hand-edit
# prisma/schema.prisma's datasource provider directly.

# --- Database -----------------------------------------------------------
# Codespace / local (default):  file:./dev.db
# Production launch (Neon):     postgresql://user:password@ep-xxxx.neon.tech/studycompanion?sslmode=require
DATABASE_URL="file:./dev.db"
DB_PROVIDER="sqlite"

# --- AI generation --------------------------------------------------------
# Groq is the sole generation provider (Gemini was removed — see
# docs/phases/PHASE_9.md). Leave keys blank until you have them — Generate
# will just fail gracefully (written to generationError) and can be
# retried once at least GROQ_API_KEY is set.
GROQ_API_KEY=""
# Optional — up to 4 more Groq keys. Any left blank simply won't appear as
# an option in the console's Generate key picker; only GROQ_API_KEY (above)
# is used at all if none of these are set, same as before this existed.
GROQ_API_KEY_2=""
GROQ_API_KEY_3=""
GROQ_API_KEY_4=""
GROQ_API_KEY_5=""
GROQ_MODEL="openai/gpt-oss-120b"

# --- Analytics dashboard (Phase 7) -----------------------------------------
# Locked thresholds (build plan §9) — tune here without a redeploy.
# engaged = active in the last N days; at-risk = 21+ days since last activity,
# or content sent but never opened at all; moderate = everything between.
ENGAGEMENT_ENGAGED_DAYS="7"
ENGAGEMENT_AT_RISK_AFTER_DAYS="21"

# --- File storage (see lib/server/storage.ts) -------------------------------
# Default (unset, or any value other than "cloudinary"): local disk under
# static/uploads/studycompanion — fine for `npm run dev`, UNSAFE for any
# multi-instance/serverless deployment (a file saved by one instance may not
# be visible to another instance's later read — this is the likely real
# cause of a 404 on a file that was just uploaded). Set to "cloudinary" and
# fill in the three CLOUDINARY_* vars below for any real deployment.
STORAGE_PROVIDER="local"
CLOUDINARY_CLOUD_NAME=""
CLOUDINARY_API_KEY=""
CLOUDINARY_API_SECRET=""

# --- Auth / sessions -------------------------------------------------------
# How long staff (console/API) and student sessions stay valid, in days.
SESSION_TTL_DAYS="30"

# --- CORS (Frontend app origin, comma-separated if more than one) --------
FRONTEND_ORIGIN="http://localhost:5174"

# --- Seed script (Phase 1) -------------------------------------------------
SEED_ADMIN_NAME="Admin"
SEED_ADMIN_PASSWORD="change-me-before-real-use"
